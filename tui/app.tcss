/* TRX full-screen layout: masthead / (nav | stream | telemetry) / command bar / footer */

Screen {
    background: $background;
    layout: vertical;
}

#masthead {
    height: 3;
    padding: 1 2 0 2;
    background: $surface;
    border-bottom: solid $primary 15%;
}

#body {
    height: 1fr;
}

Screen.compact #telemetry { display: none; }
Screen.narrow #nav { display: none; }
Screen #telemetry { display: none; }
Screen.inspecting #telemetry { display: block; }
Screen.inspecting.compact #telemetry { display: none; }

/* ---- left: navigation ---------------------------------------------------------- */
#nav {
    width: 22;
    padding: 1 1;
    background: $surface;
    border-right: solid $primary 12%;
}
#nav OptionList {
    background: transparent;
    border: none;
    height: auto;
    padding: 0;
}
#nav OptionList > .option-list--option-highlighted {
    background: $primary 10%;
    color: $foreground;
    text-style: bold;
}
.nav-label {
    color: $text-muted;
    text-style: bold;
    margin: 1 0 0 1;
}
#session {
    margin: 1 0 0 0;
    padding: 0 1;
    height: auto;
}

/* ---- centre: conversation / review stream ---------------------------------------- */
#stream {
    width: 1fr;
    padding: 1 2;
    scrollbar-color: $primary 40%;
    scrollbar-size-vertical: 1;
}
.user-msg {
    width: 100%;
    margin: 1 0 1 0;
    padding: 0;
    background: $background;
    text-style: bold;
    color: $foreground;
}
.review-card {
    height: auto;
    margin: 0 0 1 0;
    padding: 1 0;
    background: $background;
    border-top: solid $primary 25%;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
}
.patch {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    background: $background;
    border-top: solid $success 30%;
    border-title-color: $success;
}
.answer {
    height: auto;
    margin: 0 0 1 0;
    padding: 0;
    background: $background;
}

/* ---- right: telemetry ------------------------------------------------------------ */
#telemetry {
    width: 34;
    padding: 0 1;
    background: $surface;
    border-left: solid $primary 12%;
}
.tile {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 1;
    border-top: solid $primary 20%;
    border-title-color: $primary;
    border-title-style: none;
}
#confidence Digits {
    color: $primary;
    width: auto;
}
#latency-spark {
    height: 3;
    margin: 0 0 0 0;
}
#latency-spark > .sparkline--max-color { color: $accent; }
#latency-spark > .sparkline--min-color { color: $primary; }
#pipeline-bar {
    margin: 1 0 0 0;
    width: 100%;
}
#pipeline-bar Bar > .bar--bar { color: $primary; }

/* ---- bottom: command bar --------------------------------------------------------- */
#command {
    height: 3;
    margin: 0 2;
    background: $surface;
    border: round $primary 25%;
    border-title-color: $text-muted;
}
#command:focus {
    border: round $primary 65%;
}
#command-hint {
    height: 1;
    margin: 0 3;
    color: $text-muted;
}
#activity {
    height: auto;
    max-height: 3;
    margin: 0 3 1 3;
    color: $primary;
}
#welcome {
    height: auto;
    margin: 3 0;
    color: $text-muted;
}
Footer {
    background: $surface;
}

/* ---- notes, help, confirm dialog ----------------------------------------------------------- */
.note {
    height: auto;
    margin: 0 0 1 2;
}
Markdown.answer {
    padding: 0;
}
ConfirmFix {
    align: center middle;
    background: $background 70%;
}
#confirm {
    width: 72;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    background: $surface;
    border: round $warning 60%;
    border-title-color: $foreground;
}
#confirm-title { margin: 0 0 1 0; }
.confirm-finding { color: $error; }
.confirm-hint { margin: 1 0 0 0; color: $text-muted; }
#force-input { margin: 1 0 0 0; }
#confirm-buttons {
    height: auto;
    margin: 1 0 0 0;
    align: right middle;
}
#confirm-buttons Button { margin: 0 0 0 2; }
